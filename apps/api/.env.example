# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Run `npm run check:gemma` to list the Gemma 4 model ids your key can use.
GEMMA_MODEL=
# Leave false unless check:gemma shows systemInstruction works for your model.
GEMMA_USE_SYSTEM_INSTRUCTION=false
# Set this before hosting the demo publicly.
DEMO_PASSCODE=
WEB_ORIGIN=http://localhost:3000
PORT=3001

# Devdraft payments. The key needs wallet:read and transfer:create.
DEVDRAFT_CLIENT_KEY=
DEVDRAFT_CLIENT_SECRET=
# true fakes Devdraft for demos. No real payment can be made.
DEVDRAFT_SIMULATE=false

# Email for payment links, sent through Resend. Leave blank to send links by hand.
RESEND_API_KEY=
# Use an address on a domain verified in Resend. The default test sender only reaches your own account.
EMAIL_FROM=

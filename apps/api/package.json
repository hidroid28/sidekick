{
  "name": "@sidekick/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build -w @sidekick/shared && tsc -p .",
    "dev": "npm run build && node --env-file-if-exists=.env dist/main.js",
    "start": "npm run build && node --env-file-if-exists=.env dist/main.js",
    "serve": "node dist/main.js",
    "pretest": "npm run build -w @sidekick/shared",
    "test": "vitest run",
    "typecheck": "npm run build -w @sidekick/shared && tsc -p tsconfig.typecheck.json",
    "check:gemma": "npm run build && node --env-file-if-exists=.env dist/scripts/check-gemma.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@sidekick/shared": "*",
    "@types/express": "^5.0.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "unpdf": "^2.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
